VITE_API_BASE_URL=/v1

# --- Branding (see src/branding.ts) ---
# Rebranding a fork? These two are all you need for text/logo. For the browser tab icon, just
# replace public/favicon.svg with your own file — no env var, no code change. The organization
# name shown in the sidebar under this wordmark is NOT here — it's the live tenant's own name.
VITE_APP_NAME=Multistack
# Optional: path/URL to a logo image. Drop the file in public/ (e.g. public/logo.svg) and point
# this at it. Leave unset for a text-only wordmark using VITE_APP_NAME above.
# VITE_LOGO_URL=/logo.svg
# Optional: one hex accent color. Repaints every selected/highlighted surface (active sidebar
# item, buttons, tabs, focus rings, selected text) in both dark and light mode. Leave unset to
# keep the default blue.
# Quote the value — an unquoted # starts a comment in .env files and silently drops everything
# after it, so VITE_ACCENT_COLOR=#7c3aed (no quotes) becomes an EMPTY value, not this color.
# VITE_ACCENT_COLOR="#7c3aed"
# Optional: one hex page content backdrop color. Does NOT reach Header/Sidebar/cards — see
# VITE_SURFACE_COLOR below for those. Same quoting rule as above.
# VITE_BACKGROUND_COLOR="#0f172a"
# Optional: one hex Header/Sidebar/card surface color, independent of VITE_BACKGROUND_COLOR. Same
# quoting rule as above.
# VITE_SURFACE_COLOR="#1e293b"
# Optional: one hex base text color. Only primary body text changes — secondary/caption text
# stays as-is. Same quoting rule as above.
# VITE_TEXT_COLOR="#111827"
