# @multistack/ui is consumed as raw TS source via a `file:` dependency on
# the sibling ui/packages/ui (this app deliberately isn't a member of the
# ui/ npm workspace -- see package.json). npm 7+ defaults file: deps to a
# COPY install, not a symlink, which would silently pin an install-time
# snapshot of the design system instead of tracking it live. This restores
# the symlink behavior workspaces give for free.
install-links=false
