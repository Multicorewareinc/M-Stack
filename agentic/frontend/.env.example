# Where the agentic service is listening (agentic/backend/src: uvicorn main:create_app --port 8000).
AGENTIC_URL=http://localhost:8000

# The shared service key the agentic API requires (agentic/backend/.env SERVICE_API_KEY).
# Read by the Vite dev proxy and attached server-side, so it never reaches the
# browser -- see vite.config.ts.
AGENTIC_API_KEY=
