# Copy to agentic/backend/.env and fill in your own key(s). Never commit .env.
# All values are optional except SERVICE_API_KEY (defaults shown where one exists).

LOG_LEVEL=INFO

# Which provider llm.py's get_chat_model() constructs. Add a new provider
# by adding a branch there -- nothing else in this service should ever
# need to change.
LLM_PROVIDER=groq

# Optional -- each provider branch in llm.py has its own default model if
# this is unset.
# LLM_MODEL=openai/gpt-oss-20b

# "openai" only -- point at a self-hosted, OpenAI-API-compatible server
# (vLLM, llama.cpp's server, ...) instead of the real OpenAI cloud. A
# placeholder OPENAI_API_KEY is filled in automatically when this is set,
# since most self-hosted servers don't check it, but the client still
# requires something to be set to construct.
# LLM_BASE_URL=http://192.168.1.10:30080/v1

# "openai" only -- call /v1/responses instead of /v1/chat/completions.
# Needed for gpt-oss on vLLM, which returns real tool calls there without
# any server flags; on chat completions the tool arguments come back as
# plain text unless vLLM was started with --enable-auto-tool-choice
# --tool-call-parser openai. Leave unset for llama.cpp, which has no
# /v1/responses.
# LLM_USE_RESPONSES_API=true

# How many tokens of skills and tool schemas one request may load before
# the conversation itself. The default, 24000, suits a 32k-context model
# (Qwen via llama.cpp) and trims a component's dependency chain down to
# the tool alone. A larger model can hold the whole chain's rules: gpt-oss
# has 131k, so 100000 leaves room for the exchange.
# LLM_PROMPT_BUDGET_TOKENS=100000

# Read automatically by whichever provider's LangChain integration is
# selected via LLM_PROVIDER above -- only the one you're using needs a
# real value. ollama needs none of these (it's local); it needs Ollama
# itself running and the model in LLM_MODEL already pulled instead.
GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Required by main.py/dependencies.py -- every endpoint except
# /health and /metrics checks this against the client's X-API-Key header.
# Generate a real random value for this, don't leave it as a placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=
