{
  "info": {
    "name": "model-gateway e2e",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://gateway:8080" },
    { "key": "api_key", "value": "test-key" }
  ],
  "item": [
    {
      "name": "health (no auth) -> 200",
      "request": { "method": "GET", "url": "{{base_url}}/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
      ] } }]
    },
    {
      "name": "metrics (no auth) -> 200 prometheus",
      "request": { "method": "GET", "url": "{{base_url}}/metrics" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('prometheus content-type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));"
      ] } }]
    },
    {
      "name": "chat: missing key -> 401",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"llama-3-8b\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('401', () => pm.response.to.have.status(401));",
        "pm.test('authentication_error', () => pm.expect(pm.response.json().error.type).to.eql('authentication_error'));"
      ] } }]
    },
    {
      "name": "chat: bad key -> 401",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer wrong-key" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"llama-3-8b\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('401', () => pm.response.to.have.status(401));"
      ] } }]
    },
    {
      "name": "chat: valid -> 200 passthrough shape",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"llama-3-8b\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('object chat.completion', () => pm.expect(j.object).to.eql('chat.completion'));",
        "pm.test('model echoed', () => pm.expect(j.model).to.eql('llama-3-8b'));",
        "pm.test('assistant content present', () => pm.expect(j.choices[0].message.content).to.be.a('string'));"
      ] } }]
    },
    {
      "name": "completions: valid -> 200",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"llama-3-8b\",\"prompt\":\"hi\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('text_completion', () => pm.expect(pm.response.json().object).to.eql('text_completion'));"
      ] } }]
    },
    {
      "name": "chat: missing model -> 400",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"messages\":[]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400', () => pm.response.to.have.status(400));",
        "pm.test('invalid_request_error', () => pm.expect(pm.response.json().error.type).to.eql('invalid_request_error'));"
      ] } }]
    },
    {
      "name": "chat: malformed json -> 400",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{bad json" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400', () => pm.response.to.have.status(400));"
      ] } }]
    },
    {
      "name": "models: valid -> lists configured routes",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
        "url": "{{base_url}}/v1/models"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('object list', () => pm.expect(j.object).to.eql('list'));",
        "const ids = j.data.map(m => m.id);",
        "pm.test('includes llama-3-8b', () => pm.expect(ids).to.include('llama-3-8b'));",
        "pm.test('includes claude', () => pm.expect(ids).to.include('claude'));"
      ] } }]
    },
    {
      "name": "chat: streaming -> SSE passthrough",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"llama-3-8b\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":true}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('event-stream content-type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream'));",
        "const t = pm.response.text();",
        "pm.test('has SSE data', () => pm.expect(t).to.include('data:'));",
        "pm.test('has DONE sentinel', () => pm.expect(t).to.include('[DONE]'));"
      ] } }]
    },
    {
      "name": "chat: anthropic route -> translated to OpenAI",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"claude\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('translated to chat.completion', () => pm.expect(j.object).to.eql('chat.completion'));",
        "pm.test('content translated', () => pm.expect(j.choices[0].message.content).to.eql('hello'));",
        "pm.test('usage mapped', () => pm.expect(j.usage.total_tokens).to.eql(8));"
      ] } }]
    },
    {
      "name": "completions: anthropic route -> 400",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"claude\",\"prompt\":\"hi\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400', () => pm.response.to.have.status(400));"
      ] } }]
    },
    {
      "name": "rpm policy: limited-model 1/3 -> 200 (allow)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"limited-model\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 allow', () => pm.response.to.have.status(200));",
        "pm.test('X-RateLimit-Limit=3 (ADR-012)', () => pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.eql('3'));",
        "// ADR-013: /check reads BEFORE this request is counted, so remaining is 3 on the 1st call.",
        "pm.test('X-RateLimit-Remaining=3 (read before count)', () => pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('3'));",
        "pm.test('X-RateLimit-Reset present', () => pm.expect(pm.response.headers.get('X-RateLimit-Reset')).to.be.a('string'));"
      ] } }]
    },
    {
      "name": "rpm policy: limited-model 2/3 -> 200 (allow)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"limited-model\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 allow', () => pm.response.to.have.status(200));"
      ] } }]
    },
    {
      "name": "rpm policy: limited-model 3/3 -> 200 (allow, at limit)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"limited-model\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 allow', () => pm.response.to.have.status(200));"
      ] } }]
    },
    {
      "name": "rpm policy: limited-model 4th -> 429 (deny, N+1)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"limited-model\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('429 rate limited', () => pm.response.to.have.status(429));",
        "pm.test('rate_limit_exceeded type', () => pm.expect(pm.response.json().error.type).to.eql('rate_limit_exceeded'));",
        "pm.test('Retry-After header present', () => pm.expect(pm.response.headers.get('Retry-After')).to.be.a('string'));",
        "pm.test('X-RateLimit-Limit=3 on deny (ADR-012)', () => pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.eql('3'));",
        "pm.test('X-RateLimit-Remaining=0 on deny', () => pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('0'));"
      ] } }]
    },
    {
      "name": "tpm policy: tpm-limited-model 1st -> 200, X-RateLimit-Limit=15 (usage path)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/chat/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"tpm-limited-model\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 allow', () => pm.response.to.have.status(200));",
        "// ADR-013/AD-01: /check reads BEFORE this request's tokens are counted, so",
        "// remaining still equals the configured limit on this first call.",
        "pm.test('X-RateLimit-Limit=15 (TPM, generic headers work for a 2nd policy)', () => pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.eql('15'));",
        "pm.test('X-RateLimit-Remaining=15 (read before count)', () => pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('15'));"
      ] } }]
    },
    {
      "name": "tpm policy: completions (no usage in mock) -> 200, tokenizer fallback path",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": "{{base_url}}/v1/completions",
        "body": { "mode": "raw", "raw": "{\"model\":\"tpm-limited-model\",\"prompt\":\"hi\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "// The mock's /v1/completions response carries no `usage` field, so this response",
        "// event has usage=null and (EVENT_CAPTURE_BODIES=true) captured text -> exercises",
        "// AD-06's tokenizer-fallback branch in rate-limiter-tpm's consumer end to end.",
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('text_completion', () => pm.expect(pm.response.json().object).to.eql('text_completion'));"
      ] } }]
    }
  ]
}
