# Copy to .env and adjust. All values are optional (defaults shown).

API_KEY=pf-local-dev-key
LOG_LEVEL=INFO

# Upstream OpenAI-compatible inference server (vLLM / TGI / Ollama / OpenAI / ...)
UPSTREAM_URL=http://localhost:8000
# UPSTREAM_API_KEY=sk-...

# Optional per-model routing (JSON). Unlisted models use UPSTREAM_URL.
# MODEL_ROUTES={"llama-3-8b":"http://vllm:8000","gpt-4o":"https://api.openai.com"}

REQUEST_TIMEOUT=60

# Pluggable pre-request policy chain (docs/policy-plane.md). Empty = inert (default).
# Comma-separated URLs of policy services implementing POST /check.
# POLICY_ENDPOINTS=http://rate-limiter:9000/check,http://quota:9001/check
POLICY_TIMEOUT_MS=50
POLICY_FAIL_MODE=closed   # closed = block if a policy errors; open = allow through

# Event backbone (ADR-007/008/009). Empty EVENT_BACKBONE_URL = inert (default):
# no publisher is built and the request path is identical to no feature.
# EVENT_BACKBONE_URL=nats://nats:4222
EVENT_STREAM_NAME=GATEWAY_EVENTS
EVENT_STREAM_SUBJECT=gateway.events
EVENT_CAPTURE_BODIES=false   # true = also emit full request/response text (governance)
EVENT_MAX_INFLIGHT=1000      # bounded background publishes; drop when exceeded
