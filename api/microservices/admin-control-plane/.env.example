# Copy to .env and adjust. Defaults shown where they exist.

LOG_LEVEL=INFO

# Admin database (SQLAlchemy async URL, asyncpg driver). Alembic reads this too.
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/admin_control_plane

# Super-admin bearer token. Every /v1/* route requires `Authorization: Bearer <ADMIN_API_KEY>`
# (constant-time compared). /health and /metrics are exempt. NO DEFAULT — set this.
ADMIN_API_KEY=change-me

# Seed the three default plan tiers (Free/Pro/Enterprise) on startup, insert-missing only.
SEED_PLANS=true

# Seed the default master permission catalog on startup, insert-missing by slug (ADR-019).
SEED_PERMISSIONS=true

# Org CP internal API for the org-creation workflow (ADR-018/AD-03).
ORG_CP_INTERNAL_URL=http://organization-control-plane:8000
# Outbound bearer Org CP checks (shared service key for now).
SERVICE_API_KEY=change-me
ORG_TIMEOUT_MS=3000

# billing internal API — best-effort subscription notification on org creation and plan change
# (ADR-032/add-billing-plan-subscription-linkage). Reuses SERVICE_API_KEY above as the outbound
# bearer. A billing outage never fails org creation or a plan change (ADR-032) — it is logged
# and swallowed.
BILLING_INTERNAL_URL=http://billing:8000
BILLING_TIMEOUT_MS=3000
