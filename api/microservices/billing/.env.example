# Copy to .env and adjust. All values are optional (defaults shown).

LOG_LEVEL=INFO

# Billing's own database (SQLAlchemy async URL, asyncpg driver). Alembic reads this too.
# Database-per-service: owned by this service alone, no other service reads or writes it.
DATABASE_URL=postgresql+asyncpg://billing:billing@localhost:5432/billing_service

# Async metering via the ENRICHED event backbone (ADR-030/ADR-031). Empty = no consumer =>
# nothing is metered (inert path).
#
# IMPORTANT (ADR-030 AD-07): this MUST point at the ENRICHED stream, not the raw gateway
# stream — the `enricher` service guarantees a usable token count on every event here; this
# service never calls the tokenizer itself. When EVENT_BACKBONE_URL is set, both
# EVENT_STREAM_SUBJECT and EVENT_STREAM_NAME MUST equal the values below exactly, or the
# service FAILS TO START (a fail-fast RuntimeError, before any DB engine or consumer is
# constructed) — an allowlist check (must match the enriched pair), not merely "must not be
# the old raw value", so a typo'd or mismatched value is caught too, not just the raw one.
# EVENT_BACKBONE_URL=nats://nats:4222
EVENT_STREAM_NAME=GATEWAY_EVENTS_ENRICHED
EVENT_STREAM_SUBJECT=gateway.events.enriched
EVENT_DURABLE_NAME=billing-metering

# Stripe reporter (ADR-031 AD-05/AD-06) — a second surface of this same service that drains
# `outbox` rows to Stripe. Empty = INERT: zero Stripe calls, zero outbox mutations, rows stay
# pending. Setting this is the ONLY step to enable reporting — no code change.
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_METER_EVENT_NAME=tokens_used
# The Meter Event payload key the RESOLVED Stripe Customer ID is sent under (AD-06: the
# reporter resolves `principal` -> a real Stripe Customer via `stripe_customers` before
# reporting — never the raw internal principal/org_id).
STRIPE_METER_CUSTOMER_FIELD=stripe_customer_id
REPORTER_POLL_INTERVAL_SECONDS=5
REPORTER_BATCH_SIZE=50
REPORTER_MAX_ATTEMPTS=5
REPORTER_BACKOFF_BASE_SECONDS=30
REPORTER_BACKOFF_MAX_SECONDS=3600

# Gates /internal/v1/subscriptions (add-billing-plan-subscription-linkage) — admin-control-
# plane's outbound bearer to this endpoint (ADR-018 convention). No default: unset fails the
# endpoint closed as a 500 on first use, never a silent bypass.
# SERVICE_API_KEY=

# Gates POST /webhooks/stripe (add-billing-stripe-webhooks). Empty = INERT: the endpoint
# returns 501 without reading the request body or touching the database. Setting this is the
# ONLY step to enable webhook processing — no code change.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Dev-only: auto-starts `stripe listen --forward-to STRIPE_CLI_FORWARD_URL` on app startup
# (requires the Stripe CLI on PATH; see https://stripe.com/docs/stripe-cli). Prints a fresh
# whsec_... on each run — copy it into STRIPE_WEBHOOK_SECRET above. Never enable this in a
# deployed environment; a deployment registers a real webhook endpoint with Stripe instead.
# ENABLE_STRIPE_CLI=true
STRIPE_CLI_FORWARD_URL=http://localhost:8000/webhooks/stripe
