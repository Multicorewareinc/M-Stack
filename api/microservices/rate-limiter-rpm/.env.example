# Copy to .env and adjust. All values are optional (defaults shown).

LOG_LEVEL=INFO

# Shared Valkey holding the fixed-window counters (key prefix rl:rpm:).
VALKEY_URL=redis://localhost:6379/0

# RPM limits as a JSON object. Empty {} => everything unlimited.
#   user_default / model_default      : per-scope defaults (0/absent => unlimited)
#   user_overrides                    : {"<principal>": N}   overrides user_default
#   model_overrides                   : {"<model>": N}       overrides model_default
#   user_model_overrides              : {"<principal>|<model>": N}  (no default)
# A request is denied if ANY applicable scope exceeds its limit within the 60s window.
# RATE_LIMITS={"user_default":60,"model_default":0,"user_overrides":{"vip-key":600},"model_overrides":{"gpt-4o":120},"user_model_overrides":{"vip-key|gpt-4o":300}}
RATE_LIMITS={}

# Per-org plan limits (AD-04): when set, the "user" scope's limit is the resolving org's plan
# `rpm` (fetched from admin-control-plane's GET /internal/v1/organizations/{org_id}/plan and
# cached for PLAN_CACHE_TTL seconds), taking precedence over RATE_LIMITS' user_default/
# user_overrides above. Empty ADMIN_CP_URL => inert: RATE_LIMITS alone decides the user scope,
# same as before this existed. SERVICE_API_KEY must equal admin-control-plane's own SERVICE_API_KEY.
# ADMIN_CP_URL=http://admin-control-plane:8000
# SERVICE_API_KEY=
PLAN_CACHE_TTL=30

# Async counting via the event backbone (ADR-013). /check only READS counters; a NATS
# JetStream consumer increments them from the gateway's `request` events. Empty = no
# consumer => counters never advance => /check fails open (allows).
# EVENT_BACKBONE_URL=nats://nats:4222
EVENT_STREAM_NAME=GATEWAY_EVENTS
EVENT_STREAM_SUBJECT=gateway.events
EVENT_DURABLE_NAME=rpm-counter
DEDUPE_TTL=120              # seconds to remember a request_id for idempotent counting
