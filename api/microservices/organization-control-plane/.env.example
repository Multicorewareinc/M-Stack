# Copy to .env and adjust. Defaults shown where they exist.

LOG_LEVEL=INFO

# Org database (SQLAlchemy async URL, asyncpg driver). Alembic reads this too.
DATABASE_URL_ORG=postgresql+asyncpg://org:org@localhost:5432/org_control_plane

# Service bearer token. Every /v1/* and /internal/* route requires
# `Authorization: Bearer <SERVICE_API_KEY>` (constant-time compared). /health and /metrics are
# exempt. NO DEFAULT — set this. Shared with the calling control plane (Admin CP) for now.
SERVICE_API_KEY=change-me


# --- Invitations -------------------------------------------------------------------------------
# How long an invitation link stays valid, in hours.
# INVITATION_TTL_HOURS=168
# Public URL of the Organization Portal. Invitation links (and the invitation email) point here.
# ORG_PORTAL_BASE_URL=http://localhost:5174

# Email the invitation. Needs SMTP_HOST, SMTP_FROM_ADDRESS and ORG_PORTAL_BASE_URL; without them the
# invitation is still created and the link is shown to copy.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# starttls (587) | ssl (465) | none (local relay / test mailbox only)
# SMTP_SECURITY=starttls
# SMTP_USERNAME=mailer
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@example.com
# SMTP_FROM_NAME=Multistack
# SMTP_TIMEOUT_SECONDS=10
