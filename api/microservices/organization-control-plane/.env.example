# Copy to .env and adjust. Defaults shown where they exist.

LOG_LEVEL=INFO

# Org database (SQLAlchemy async URL, asyncpg driver). Alembic reads this too.
DATABASE_URL=postgresql+asyncpg://org:org@localhost:5432/org_control_plane

# Service bearer token. Every /v1/* and /internal/* route requires
# `Authorization: Bearer <SERVICE_API_KEY>` (constant-time compared). /health and /metrics are
# exempt. NO DEFAULT — set this. Shared with the calling control plane (Admin CP) for now.
SERVICE_API_KEY=change-me
