# Copy to api/microservices/rag/src/.env for local runs (the service reads
# .env from where it runs). Never commit .env.

LOG_LEVEL=INFO

# Callers send this as `Authorization: Bearer <key>`. Required: unset, every
# /v1 call fails with a 500. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=

# The embedding server (OpenAI-compatible /v1/embeddings). Search and the
# indexer must use the same model, or the vectors are not comparable.
EMBEDDING_URL=http://192.168.1.10:30801/v1/embeddings
EMBEDDING_MODEL=qwen3-embedding-0.6b
# EMBEDDING_DIMENSION=1024
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_TIMEOUT_SECONDS=60          indexing
# SEARCH_EMBEDDING_TIMEOUT_SECONDS=4    a search; keep it under the caller's own timeout
# QUERY_INSTRUCTION=Given a question about deploying Multistack infrastructure, retrieve the SDK fields, rules and code that answer it
# How the embedding model wants each side wrapped (README: Using another embedding model).
# Keep the quotes: inside them \n is a newline.
# QUERY_TEMPLATE="Instruct: {instruction}\nQuery:{query}"
# DOCUMENT_TEMPLATE={text}
# EMBEDDING_MAX_INPUT_TOKENS=4096   longer text is cut to this

# Chunking: the longest chunk, and what consecutive parts of a longer unit share.
# CHUNK_MAX_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64

# The vector database this service owns.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=multistack_reference

# Search. The defaults were chosen by scoring (see README).
# TOP_K=8                  passages per question
# BUDGET_TOKENS=6000       most tokens of the whole reference block per question
# MIN_SCORE=0.64           best chunk must be at least this similar, or nothing is returned
# MIN_QUERY_TERMS=2        question must share this many words with the index, or nothing is returned
# STUB_PENALTY=0.5         multiplier on short "class X" chunks
# CAPABILITY_BOOST=1.0     multiplier on chunks of the capabilities the caller names
# SKILL_SLOTS=2            of TOP_K, how many are held for the named capabilities' own skill notes

# The reranker: a cross-encoder behind vLLM's /v1/rerank. Unset = no reranking.
# RERANK_URL=http://<reranker-server>/v1/rerank
# RERANK_MODEL=qwen3-reranker-0.6b
# A larger reranker (e.g. qwen3-reranker-8b) was tried and reverted: it
# crashed under repeated real-size requests on the shared GPU server.
# Don't switch to it again until that's confirmed stable under load.
# RERANK_CANDIDATES=10        how many of the top merged candidates are reranked
# RERANK_PER_RANKING=20       also reranked: the top this many of each ranking on its own
# RERANK_TIMEOUT_SECONDS=5    past this, the merged order is kept
# RERANK_MIN_SCORE=0.05       once reranked, a passage scoring below this isn't sent
# RERANK_KEEP=3               the best this many are sent whatever they scored
# Each clause of a question also searched on its own (needs the reranker to score them):
# CLAUSE_SEARCH=true
# CLAUSE_CANDIDATES=5         the best this many of each clause's search join the reranked candidates
# MAX_CLAUSES=6               at most this many clauses searched per question
# CLAUSE_SLOTS=1              of each clause's passages, the best this many reach the chat-model ranking
# Only for rerankers that expect a prompt (Qwen3-Reranker does):
# RERANK_QUERY_TEMPLATE={query}
# RERANK_DOCUMENT_TEMPLATE={document}

# A chat model as an optional second ranking step after the reranker above:
# it names which of the best candidates help answer the question. Unset =
# the reranker's order is final. Leave unset when the reranker alone (e.g.
# qwen3-reranker-8b) already separates candidates well -- this step adds
# several seconds of latency per search for whatever it gains.
# LLM_RERANK_URL=http://<chat-model-server>/v1/chat/completions
# LLM_RERANK_MODEL=gpt-oss-120b
# LLM_RERANK_CANDIDATES=15         how many of the best it reads
# LLM_RERANK_TIMEOUT_SECONDS=15    past this, the reranker's order is kept
# LLM_RERANK_SUBJECT=the Multistack platform
# LLM_RERANK_ONLY_USEFUL=false     send only what it called useful...
# LLM_RERANK_MIN_PASSAGES=3        ...but at least this many

# An identical search within this many seconds gets the same result. 0 = off.
# SEARCH_CACHE_SECONDS=600
# SEARCH_CACHE_SIZE=256
