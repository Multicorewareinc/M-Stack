# Copy to .env and adjust. All values are optional (defaults shown).

LOG_LEVEL=INFO

# Shared Valkey holding the fixed-window counters (key prefix rl:tpm:) — the SAME instance
# rate-limiter-rpm uses (ADR-011); the two keyspaces never collide.
VALKEY_URL=redis://localhost:6379/0

# TPM limits as a JSON object (values are TOKEN counts, not request counts).
#   user_default / model_default      : per-scope defaults (0/absent => unlimited)
#   user_overrides                    : {"<principal>": N}   overrides user_default
#   model_overrides                   : {"<model>": N}       overrides model_default
#   user_model_overrides              : {"<principal>|<model>": N}  (no default)
# A request is denied if ANY applicable scope exceeds its token limit within the 60s window.
# RATE_LIMITS={"user_default":60000,"model_default":0,"user_overrides":{"vip-key":600000},"model_overrides":{"gpt-4o":120000},"user_model_overrides":{"vip-key|gpt-4o":300000}}
RATE_LIMITS={}

# Per-org plan limits (AD-04): when set, the "user" scope's limit is the resolving org's plan
# `tpm` (fetched from admin-control-plane's GET /internal/v1/organizations/{org_id}/plan and
# cached for PLAN_CACHE_TTL seconds), taking precedence over RATE_LIMITS' user_default/
# user_overrides above. Empty ADMIN_CP_URL => inert: RATE_LIMITS alone decides the user scope,
# same as before this existed. SERVICE_API_KEY must equal admin-control-plane's own SERVICE_API_KEY.
# ADMIN_CP_URL=http://admin-control-plane:8000
# SERVICE_API_KEY=
PLAN_CACHE_TTL=30

# Async counting via the event backbone (AD-01/AD-02, ADR-030). /check only READS counters;
# a NATS JetStream consumer increments them from the gateway's `response` events (NOT
# `request` events, unlike rate-limiter-rpm). Empty = no consumer => counters never advance
# => /check fails open (allows).
#
# IMPORTANT (ADR-030 AD-07): this MUST point at the ENRICHED stream, not the raw gateway
# stream — the `enricher` service guarantees a usable token count on every event here; this
# service no longer calls the tokenizer itself. When EVENT_BACKBONE_URL is set, both
# EVENT_STREAM_SUBJECT and EVENT_STREAM_NAME MUST equal the values below exactly, or the
# service FAILS TO START (a fail-fast RuntimeError, not a silent miscounts) — this is an
# allowlist check (must match the enriched pair), not merely "must not be the old raw
# value", so a typo'd or mismatched value is caught too, not just the raw one.
# EVENT_BACKBONE_URL=nats://nats:4222
EVENT_STREAM_NAME=GATEWAY_EVENTS_ENRICHED
EVENT_STREAM_SUBJECT=gateway.events.enriched
EVENT_DURABLE_NAME=tpm-counter-enriched
DEDUPE_TTL=120              # seconds to remember a request_id for idempotent counting
