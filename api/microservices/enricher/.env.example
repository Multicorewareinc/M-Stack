# Copy to .env and adjust. All values are optional (defaults shown).

LOG_LEVEL=INFO

# Backbone connection (ADR-007/008). Empty = no consumer runs => the enricher is inert
# (nothing consumed/republished). Same discipline as the other backbone consumers.
# EVENT_BACKBONE_URL=nats://nats:4222

# Input: the gateway's canonical stream (unchanged). The enricher consumes its `response`
# events; it never modifies the gateway or this stream.
EVENT_STREAM_NAME=GATEWAY_EVENTS
EVENT_STREAM_SUBJECT=gateway.events
EVENT_DURABLE_NAME=enricher

# Output: a SEPARATE derived stream (ADR-030) so retention/cursors are independent and
# enriched output never feeds back into the input subject. Size this stream's dedup window
# and retention to cover the slowest enriched consumer's lag and the max redelivery span;
# size the raw GATEWAY_EVENTS retention to allow input replay after a terminal republish
# failure.
ENRICHED_STREAM_NAME=GATEWAY_EVENTS_ENRICHED
ENRICHED_SUBJECT=gateway.events.enriched

# Bounded redelivery for the not-ack-on-republish-failure path (ADR-030 D5). A failing
# republish is retried up to MAX_DELIVER times; terminal exhaustion is logged + metered.
# ACK_WAIT_SECONDS MUST be >= TOKENIZER_TIMEOUT_MS (in seconds) + a republish margin, else
# JetStream redelivers while the first attempt is still in flight and burns MAX_DELIVER budget.
MAX_DELIVER=5
ACK_WAIT_SECONDS=30

# Tokenizer fallback (ADR-030 AD-02/AD-03), used only when a response event's `usage` is
# absent. Must be the FULL /tokenize URL. Empty = degraded-not-dead: usage-less events are
# republished with source="none" (reason="tokenizer_unset"), never a startup failure.
# Requires the gateway's EVENT_CAPTURE_BODIES=true to have any text to tokenize.
# TOKENIZER_URL=http://tokenizer:8000/tokenize
TOKENIZER_TIMEOUT_MS=2000
